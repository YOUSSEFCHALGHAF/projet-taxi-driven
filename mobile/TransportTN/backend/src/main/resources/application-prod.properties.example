# ============================================
# Exemple de configuration PRODUCTION
# Copier en application-prod.properties et remplir les valeurs reelles,
# ou (recommande) surcharger via des variables d'environnement.
# Lancer avec: java -jar app.jar --spring.profiles.active=prod
# ============================================

spring.datasource.url=jdbc:mysql://${DB_HOST}:3306/transporttn?useSSL=true&serverTimezone=UTC
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASSWORD}

spring.jpa.hibernate.ddl-auto=validate

app.jwt.secret=${JWT_SECRET}
app.jwt.expiration-ms=86400000

app.otp.debug-mode=false

app.firebase.credentials-path=${FIREBASE_CREDENTIALS_PATH}

logging.level.com.transporttn=INFO
logging.level.org.springframework.security=WARN
