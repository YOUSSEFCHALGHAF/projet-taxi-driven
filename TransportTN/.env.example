# Copier ce fichier en .env pour changer les identifiants (facultatif)
MYSQL_ROOT_PASSWORD=root_pwd
DB_USERNAME=transporttn
DB_PASSWORD=transporttn_pwd
# ---------- Domaine ----------
# Nom de domaine pointant vers l'adresse IP du serveur (enregistrement DNS de type A).
# Pour un test sur votre machine : DOMAINE=localhost (le site reste en HTTP).
DOMAINE=transporttn.example.tn
# Adresse e-mail pour Let's Encrypt (avertissements d'expiration du certificat)
EMAIL_LETSENCRYPT=vous@example.tn

# ---------- Base de données ----------
# Générez des mots de passe forts, par exemple : openssl rand -base64 24
MYSQL_ROOT_PASSWORD=a-remplacer
MYSQL_PASSWORD=a-remplacer

# ---------- JWT ----------
# Générez une clé : openssl rand -base64 64
JWT_SECRET=a-remplacer

# ---------- Firebase (facultatif) ----------
# Backend : mettre true et placer la clé du compte de service dans secrets/firebase-service-account.json
FIREBASE_ENABLED=false
# Frontend : configuration de l'application Web Firebase (valeurs publiques)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=